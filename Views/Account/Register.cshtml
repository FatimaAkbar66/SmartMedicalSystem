@model SmartMedicalSystem.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register — Smart Medical System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="auth-page">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">

                <div class="auth-card">

                    <!-- Header -->
                    <div class="auth-header">
                        <div class="logo-circle">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>
                        <h2>Create Account</h2>
                        <p>Join the Smart Medical Error Prevention System</p>
                    </div>

                    <!-- Body -->
                    <div class="auth-body">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger small py-2 mb-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @Html.ValidationSummary(true)
                            </div>
                        }

                        <form asp-action="Register" method="post">

                            <!-- Role Selection -->
                            <div class="mb-4">
                                <label class="form-label">I am registering as</label>
                                <div class="row g-2" id="roleSelector">
                                    @foreach (var role in new[]
                                                                        {
                                                                        ("Doctor",     "bi-person-badge",  "Prescribing physician"),
                                                                        ("Patient",    "bi-person-heart",  "Receiving treatment"),
                                                                        ("Pharmacist", "bi-bag-heart",     "Dispensing medicines"),
                                                                        })
                                    {
                                        <div class="col-4">
                                            <input type="radio"
                                                   name="Role"
                                                   id="role_@role.Item1"
                                                   value="@role.Item1"
                                                   class="d-none role-radio"
                                                   onchange="toggleRoleFields('@role.Item1')"
                                            @(role.Item1 == "Patient" ? "checked" : "") />
                                            <label for="role_@role.Item1"
                                                   class="role-card text-center p-3 border rounded
                                                d-block cursor-pointer"
                                                   style="cursor:pointer;transition:all .2s;">
                                                <i class="bi @role.Item2 d-block mb-1"
                                                   style="font-size:1.4rem;color:#4b0082;"></i>
                                                <strong style="font-size:.8rem;">
                                                    @role.Item1
                                                </strong>
                                                <div style="font-size:.7rem;color:#94a3b8;">
                                                    @role.Item3
                                                </div>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Common Fields -->
                            <div class="row g-3 mb-3">
                                <div class="col-12">
                                    <label asp-for="Name" class="form-label">
                                        Full Name
                                    </label>
                                    <input asp-for="Name"
                                           class="form-control"
                                           placeholder="e.g. Dr. Sarah Ahmed" />
                                    <span asp-validation-for="Name"
                                          class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label">
                                        Email Address
                                    </label>
                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="you@example.com" />
                                    <span asp-validation-for="Email"
                                          class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label">
                                        Phone Number
                                    </label>
                                    <input asp-for="Phone"
                                           class="form-control"
                                           placeholder="03XX-XXXXXXX" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label">
                                        Password
                                    </label>
                                    <input asp-for="Password"
                                           class="form-control"
                                           type="password"
                                           placeholder="Min 6 characters" />
                                    <span asp-validation-for="Password"
                                          class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword"
                                           class="form-label">
                                        Confirm Password
                                    </label>
                                    <input asp-for="ConfirmPassword"
                                           class="form-control"
                                           type="password"
                                           placeholder="Repeat password" />
                                    <span asp-validation-for="ConfirmPassword"
                                          class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Doctor Fields -->
                            <div id="doctorFields" class="d-none">
                                <div class="p-3 mb-3 rounded"
                                     style="background:#f8f0ff;border:1px solid #e9d5ff;">
                                    <p class="fw-600 small mb-2" style="color:#4b0082;">
                                        <i class="bi bi-person-badge me-1"></i>
                                        Doctor Information
                                    </p>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label asp-for="Specialization"
                                                   class="form-label">
                                                Specialization
                                            </label>
                                            <input asp-for="Specialization"
                                                   class="form-control"
                                                   placeholder="e.g. Internal Medicine" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="LicenseNo"
                                                   class="form-label">
                                                License No
                                            </label>
                                            <input asp-for="LicenseNo"
                                                   class="form-control"
                                                   placeholder="e.g. PMC-2024-001" />
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="Department"
                                                   class="form-label">
                                                Department
                                            </label>
                                            <input asp-for="Department"
                                                   class="form-control"
                                                   placeholder="e.g. General Medicine" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Patient Fields -->
                            <div id="patientFields">
                                <div class="p-3 mb-3 rounded"
                                     style="background:#f0fdf4;border:1px solid #bbf7d0;">
                                    <p class="fw-600 small mb-2"
                                       style="color:#065f46;">
                                        <i class="bi bi-person-heart me-1"></i>
                                        Patient Information
                                    </p>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label asp-for="DateOfBirth"
                                                   class="form-label">
                                                Date of Birth
                                            </label>
                                            <input asp-for="DateOfBirth"
                                                   class="form-control"
                                                   type="date" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Gender"
                                                   class="form-label">
                                                Gender
                                            </label>
                                            <select asp-for="Gender"
                                                    class="form-select">
                                                <option value="">Select</option>
                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="BloodGroup"
                                                   class="form-label">
                                                Blood Group
                                            </label>
                                            <select asp-for="BloodGroup"
                                                    class="form-select">
                                                <option value="">Select</option>
                                                @foreach (var bg in new[]
                                                                                                { "A+","A-","B+","B-","AB+","AB-","O+","O-" })
                                                {
                                                    <option value="@bg">@bg</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="Weight"
                                                   class="form-label">
                                                Weight (kg)
                                            </label>
                                            <input asp-for="Weight"
                                                   class="form-control"
                                                   type="number"
                                                   placeholder="e.g. 70" />
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="Height"
                                                   class="form-label">
                                                Height (cm)
                                            </label>
                                            <input asp-for="Height"
                                                   class="form-control"
                                                   type="number"
                                                   placeholder="e.g. 170" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <button type="submit"
                                    class="btn btn-primary w-100 py-2 fw-600 mb-3">
                                <i class="bi bi-person-check me-2"></i>
                                Create Account
                            </button>

                            <p class="text-center small text-muted mb-0">
                                Already have an account?
                                <a asp-action="Login"
                                   style="color:#4b0082;font-weight:600;">
                                    Sign in here
                                </a>
                            </p>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
    </script>
    <script>
            // Show/hide role-specific fields
            function toggleRoleFields(role) {
                document.getElementById('doctorFields')
                    .classList.toggle('d-none', role !== 'Doctor');
                document.getElementById('patientFields')
                    .classList.toggle('d-none', role !== 'Patient');
            }

            // Style selected role card
            document.querySelectorAll('.role-radio')
                .forEach(radio => {
                    radio.addEventListener('change', function () {
                        document.querySelectorAll('.role-card')
                            .forEach(card => {
                                card.style.background   = '';
                                card.style.borderColor  = '';
                                card.style.color        = '';
                            });
                        this.nextElementSibling.style.background  = '#f3e8ff';
                        this.nextElementSibling.style.borderColor = '#7b2fbe';
                    });
                });

            // Init on load
            toggleRoleFields('Patient');

            // Style default selected
            const defaultRadio = document.getElementById('role_Patient');
            if (defaultRadio) {
                defaultRadio.nextElementSibling.style.background  = '#f3e8ff';
                defaultRadio.nextElementSibling.style.borderColor = '#7b2fbe';
            }
    </script>
</body>
</html>