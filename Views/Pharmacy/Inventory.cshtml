@model List<SmartMedicalSystem.Models.Entities.Medicine>
@{
    ViewData["Title"] = "Medicine Inventory";
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-boxes me-2"></i>
            Medicine Inventory
        </h1>
        <p class="page-subtitle">
            @Model.Count medicines in stock
        </p>
    </div>
    <a asp-action="Index"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>
        Dashboard
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Medicine</th>
                    <th>Category</th>
                    <th>Current Stock</th>
                    <th>Reorder Level</th>
                    <th>Expiry</th>
                    <th>Price</th>
                    <th>Update Stock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var med in Model)
                {
                    var isLow = med.StockQuantity
                    <= med.ReorderLevel;
                    <tr class="@(isLow ? "table-warning" : "")">
                        <td>
                            <div class="fw-600 small">
                                @med.GenericName
                            </div>
                            <div class="text-muted"
                                 style="font-size:.72rem;">
                                @med.BrandNames
                                .Split(',').FirstOrDefault()
                            </div>
                        </td>
                        <td class="small">@med.Category</td>
                        <td>
                            <span class="badge bg-@(
                                  isLow ? "danger" : "success")
                                  px-2">
                                @med.StockQuantity units
                            </span>
                            @if (isLow)
                            {
                                <div class="text-danger"
                                     style="font-size:.72rem;">
                                    ⚠ Low stock
                                </div>
                            }
                        </td>
                        <td class="small text-muted">
                            @med.ReorderLevel units
                        </td>
                        <td class="small">
                            @if (med.ExpiryDate.HasValue)
                            {
                                var expired = med.ExpiryDate
                                < DateTime.Today;
                                var expiring = med.ExpiryDate
                                <= DateTime.Today
                                .AddDays(30);
                                <span class="badge bg-@(
                                      expired ? "danger" :
                                      expiring ? "warning" :
                                      "success") text-@(
                                      expiring && !expired
                                          ? "dark" : "")">
                                    @med.ExpiryDate
                                    .Value.ToString(
                                    "dd MMM yyyy")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="small">
                            Rs. @med.Price.ToString("F0")
                        </td>
                        <td>
                            <form asp-action="UpdateStock"
                                  method="post"
                                  class="d-flex gap-1">
                                <input type="hidden"
                                       name="medicineId"
                                       value="@med.MedicineID" />
                                <input type="number"
                                       name="quantity"
                                       class="form-control
                                              form-control-sm"
                                       style="width:80px;"
                                       value="@med.StockQuantity"
                                       min="0" />
                                <button type="submit"
                                        class="btn btn-sm
                                               btn-primary">
                                    <i class="bi bi-save"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>