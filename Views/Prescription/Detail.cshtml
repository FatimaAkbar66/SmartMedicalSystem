@model SmartMedicalSystem.Models.ViewModels.PrescriptionDetailViewModel
@{
    ViewData["Title"] = "Prescription Detail";
    var rx = Model.Prescription;
    var risk = Model.RiskAssessment;
}

<!-- Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-journal-medical me-2"></i>
            Prescription Detail
        </h1>
        <p class="page-subtitle">
            Rx Code:
            <code>@rx.PrescriptionCode</code> —
            Issued @rx.DateIssued.ToString("dd MMM yyyy HH:mm")
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="DownloadPdf"
           asp-route-id="@rx.PrescriptionID"
           class="btn btn-outline-danger">
            <i class="bi bi-file-pdf me-2"></i>
            Download PDF
        </a>
        <a asp-action="List"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            Back
        </a>
    </div>
</div>

<div class="row g-4">

    <!-- ── LEFT: Main Details ─────────────────── -->
    <div class="col-xl-8">

        <!-- Patient + Doctor Info -->
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-4">

                    <!-- Patient -->
                    <div class="col-md-6">
                        <p class="text-muted small fw-600
                               text-uppercase mb-2">
                            Patient Information
                        </p>
                        <h5 class="fw-700 mb-1">
                            @rx.Patient?.User?.Name
                        </h5>
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            <span class="badge"
                                  style="background:#f0e6ff;
                                     color:#4b0082;">
                                @rx.Patient?.Gender
                            </span>
                            <span class="badge"
                                  style="background:#fce7f3;
                                     color:#9d174d;">
                                @rx.Patient?.BloodGroup
                            </span>
                            <span class="badge"
                                  style="background:#ecfdf5;
                                     color:#065f46;">
                                @rx.Patient?.Weight kg
                            </span>
                        </div>
                        @if (rx.Patient?.Allergies?.Any() == true)
                        {
                            <div class="p-2 rounded"
                                 style="background:#fef2f2;
                                        border:1px solid #fecaca;">
                                <small class="text-danger fw-600">
                                    ⚠ Allergies:
                                </small>
                                <small class="text-danger">
                                    @string.Join(", ",
                                    rx.Patient.Allergies
                                    .Select(a => a.Allergen))
                            </small>
                        </div>
                                                }
                    </div>

                    <!-- Doctor -->
                    <div class="col-md-6">
                        <p class="text-muted small fw-600
                               text-uppercase mb-2">
                            Prescribing Physician
                        </p>
                        <h5 class="fw-700 mb-1">
                            Dr. @rx.Doctor?.User?.Name
                        </h5>
                        <p class="text-muted small mb-1">
                            @rx.Doctor?.Specialization —
                            @rx.Doctor?.Department
                        </p>
                        <p class="text-muted small mb-0">
                            License: @rx.Doctor?.LicenseNo
                        </p>
                    </div>
                </div>

                <hr class="my-3" />

                <!-- Diagnosis + Status Row -->
                <div class="row g-2 align-items-center">
                    <div class="col-md-8">
                        <span class="text-muted small fw-600">
                            Diagnosis:
                        </span>
                        <span class="small ms-1">
                            @rx.Diagnosis
                        </span>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <span class="badge bg-@(
                              rx.Status == "Active"
                                  ? "success"
                                  : rx.Status == "Dispensed"
                                  ? "info" : "secondary")
                          px-3 py-2">
                            @rx.Status
                        </span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(rx.Notes))
                {
                    <div class="mt-2 p-2 rounded small"
                         style="background:#f8f9fc;">
                        <i class="bi bi-chat-text me-1
                                   text-muted"></i>
                        @rx.Notes
                    </div>
                }
            </div>
        </div>

        <!-- Medications Table -->
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-capsule me-2 text-purple"></i>
                Prescribed Medications
                <span class="badge ms-2"
                      style="background:#f0e6ff;
                         color:#4b0082;">
                    @rx.Items.Count item(s)
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Medicine</th>
                            <th>Ingredient</th>
                            <th>Dose</th>
                            <th>Frequency</th>
                            <th>Duration</th>
                            <th>Route</th>
                            <th>Instructions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int n = 1;
                        }
                        @foreach (var item in rx.Items)
                        {
                            <tr>
                                <td class="text-muted">@(n++)</td>
                                <td>
                                    <strong>
                                        @item.Medicine?.GenericName
                                    </strong>
                                    <br />
                                    <small class="text-muted">
                                        @item.Medicine?.BrandNames
                                        ?.Split(',').FirstOrDefault()
                                    </small>
                                </td>
                                <td class="text-muted small">
                                    @item.Medicine?.ActiveIngredient
                                </td>
                                <td>
                                    <span class="badge bg-primary">
                                        @item.Dosage mg
                                    </span>
                                </td>
                                <td class="small">@item.Frequency</td>
                                <td class="small">
                                    @item.DurationDays days
                                </td>
                                <td class="small">@item.Route</td>
                                <td class="text-muted small">
                                    @(item.Instructions ?? "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Safety Alerts -->
        @if (Model.Alerts.Any())
        {
            <div class="card">
                <div class="card-header text-danger">
                    <i class="bi bi-exclamation-triangle-fill
                               me-2"></i>
                    Safety Alerts Recorded
                    <span class="badge bg-danger ms-2">
                        @Model.Alerts.Count
                    </span>
                </div>
                <div class="card-body p-0">
                    @foreach (var alert in Model.Alerts)
                    {
                        <div class="p-3 border-bottom
                                 alert-left-@alert.Severity.ToLower()">
                            <div class="d-flex justify-content-between
                                            align-items-start">
                                <div>
                                    <div class="d-flex gap-2 mb-1">
                                        <span class="badge bg-@(
                                              alert.Severity == "Critical"
                                                  ? "danger"
                                                  : alert.Severity == "Warning"
                                                  ? "warning" : "info") text-@(
                                              alert.Severity == "Warning"
                                                  ? "dark" : "")">
                                            @alert.AlertType
                                        </span>
                                        <span class="badge
                                                  bg-secondary">
                                            @alert.Severity
                                        </span>
                                        @if (alert.IsOverridden)
                                        {
                                            <span class="badge
                                                          bg-warning
                                                          text-dark">
                                                Overridden
                                            </span>
                                        }
                                    </div>
                                    <p class="mb-1 small">
                                        @alert.Message
                                    </p>
                                    @if (alert.IsOverridden &&
                                                                !string.IsNullOrEmpty(
                                                                alert.OverrideReason))
                                    {
                                        <p class="mb-0 text-muted"
                                           style="font-size:.76rem;">
                                            <i class="bi bi-person-check
                                                               me-1"></i>
                                            Override by
                                            @alert.OverriddenBy:
                                            @alert.OverrideReason
                                        </p>
                                    }
                                </div>
                                <small class="text-muted
                                                  flex-shrink-0">
                                    @alert.CreatedAt
                                    .ToString("HH:mm")
                                </small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body text-center py-3">
                    <i class="bi bi-shield-check text-success
                               d-block mb-2"
                       style="font-size:2rem;"></i>
                    <p class="text-success fw-600 mb-0">
                        No safety alerts — clean prescription
                    </p>
                </div>
            </div>
        }

    </div>

    <!-- ── RIGHT: AI Risk + Stats ─────────────── -->
    <div class="col-xl-4">

        <!-- AI Risk Assessment -->
        @if (risk != null)
        {
            <div class="card mb-3">
                <div class="card-header"
                     style="background:linear-gradient(135deg,
                                #2d0050,#4b0082);
                            color:white;">
                    <i class="bi bi-cpu me-2"></i>
                    ML.NET Risk Assessment
                </div>
                <div class="card-body text-center py-4">
                    <div class="risk-circle @risk.RiskColor">
                        @((risk.RiskScore * 100).ToString("F0"))%
                    </div>
                    <h4 class="fw-700 mt-2
                                text-@risk.RiskColor">
                        @risk.RiskLevel Risk
                    </h4>
                    <div class="progress my-2"
                         style="height:8px;">
                        <div class="progress-bar
                                    bg-@risk.RiskColor"
                             style="width:@((risk.RiskScore * 100)
                                                                 .ToString("F0"))%">
                        </div>
                    </div>
                    <p class="text-muted small">
                        @risk.Summary
                    </p>

                    @if (risk.ContributingFactors.Any())
                    {
                        <div class="text-start mb-3">
                            <p class="fw-600 small mb-1">
                                Risk Factors
                            </p>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var f in
                                                        risk.ContributingFactors)
                                {
                                    <span class="badge"
                                          style="background:#fee2e2;
                                                         color:#b91c1c;">
                                        @f
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    @if (risk.Recommendations.Any())
                    {
                        <div class="text-start">
                            <p class="fw-600 small mb-1">
                                Recommendations
                            </p>
                            @foreach (var r in risk.Recommendations)
                            {
                                <div class="d-flex gap-2 mb-1">
                                    <i class="bi bi-chevron-right
                                                       text-purple mt-1
                                                       flex-shrink-0"
                                       style="font-size:.7rem;">
                                    </i>
                                    <span style="font-size:.78rem;">
                                        @r
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Quick Stats -->
        <div class="card">
            <div class="card-header">
                <i class="bi bi-bar-chart me-2"></i>
                Prescription Summary
            </div>
            <div class="card-body">
                @foreach (var stat in new[]
                                {
                                ("Total Medicines",
                                rx.Items.Count.ToString(),
                                        "bi-capsule", "#f0e6ff", "#4b0082"),
                                ("Safety Alerts",
                                Model.Alerts.Count.ToString(),
                                        "bi-exclamation-triangle",
                                Model.Alerts.Any()
                                ? "#fee2e2" : "#f0fdf4",
                                Model.Alerts.Any()
                                ? "#b91c1c" : "#065f46"),
                                ("Critical Alerts",
                                Model.Alerts.Count(a =>
                                a.Severity == "Critical")
                                .ToString(),
                                        "bi-shield-x",
                                        "#fee2e2", "#b91c1c"),
                                ("AI Risk Score",
                                (rx.AIRiskScore * 100)
                                .ToString("F0") + "%",
                                        "bi-cpu", "#f0e6ff", "#4b0082"),
                                })
                {
                    <div class="d-flex justify-content-between
                                align-items-center
                                py-2 border-bottom">
                        <span class="small text-muted">
                            <i class="bi @stat.Item3 me-2"></i>
                            @stat.Item1
                        </span>
                        <span class="badge fw-600"
                              style="background:@stat.Item4;
                                     color:@stat.Item5;">
                            @stat.Item2
                        </span>
                    </div>
                }

                <div class="d-flex justify-content-between
                        align-items-center pt-2">
                    <span class="small text-muted">
                        <i class="bi bi-activity me-2"></i>
                        Risk Level
                    </span>
                    <span class="risk-badge
                      risk-@rx.AIRiskLevel.ToLower()">
                        @rx.AIRiskLevel
                    </span>
                </div>
            </div>
        </div>

    </div>
</div>