@model List<SmartMedicalSystem.Models.Entities.Prescription>
@{
    ViewData["Title"] = "Prescriptions";
}

<!-- Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-journal-medical me-2"></i>
            My Prescriptions
        </h1>
        <p class="page-subtitle">
            @Model.Count total prescription(s) issued
        </p>
    </div>
    <a asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>
        New Prescription
    </a>
</div>

<!-- Filter Bar -->
<div class="card mb-4">
    <div class="card-body py-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text"
                       id="searchInput"
                       class="form-control"
                       placeholder="Search patient or diagnosis..."
                       oninput="filterTable()" />
            </div>
            <div class="col-md-2">
                <select id="statusFilter"
                        class="form-select"
                        onchange="filterTable()">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Dispensed">Dispensed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="riskFilter"
                        class="form-select"
                        onchange="filterTable()">
                    <option value="">All Risk</option>
                    <option value="High">High</option>
                    <option value="Medium">Medium</option>
                    <option value="Low">Low</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100"
                        onclick="clearFilters()">
                    Clear
                </button>
            </div>
            <div class="col-md-2 text-end">
                <span class="text-muted small"
                      id="rowCount">
                    @Model.Count results
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Prescriptions Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0"
               id="rxTable">
            <thead>
                <tr>
                    <th>Rx Code</th>
                    <th>Patient</th>
                    <th>Diagnosis</th>
                    <th>Medicines</th>
                    <th>AI Risk</th>
                    <th>Alerts</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="rxTableBody">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9"
                            class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x d-block mb-2"
                               style="font-size:2.5rem;"></i>
                            No prescriptions found.<br />
                            <a asp-action="Create">
                                Create your first prescription
                            </a>
                        </td>
                    </tr>
                }
                @foreach (var rx in Model)
                {
                    <tr data-status="@rx.Status"
                        data-risk="@rx.AIRiskLevel"
                        data-search="@rx.Patient?.User?.Name
                        @rx.Diagnosis
                        @rx.PrescriptionCode">
                        <td>
                            <code>@rx.PrescriptionCode</code>
                        </td>
                        <td class="fw-600">
                            @rx.Patient?.User?.Name
                        </td>
                        <td>
                            <span class="text-muted small"
                                  title="@rx.Diagnosis">
                                @(rx.Diagnosis.Length > 35
                                                            ? rx.Diagnosis
                                                            .Substring(0, 35) + "…"
                                                            : rx.Diagnosis)
                            </span>
                        </td>
                        <td>
                            <span class="badge"
                                  style="background:#f0e6ff;
                                color:#4b0082;">
                                @rx.ValidationAlerts.Count == 0
                                ? "—"
                                : rx.ValidationAlerts.Count
                                + " items"
                            </span>
                        </td>
                        <td>
                            <span class="risk-badge
                                risk-@rx.AIRiskLevel.ToLower()">
                                <i class="bi bi-circle-fill"
                                   style="font-size:.4rem;"></i>
                                @rx.AIRiskLevel
                            </span>
                        </td>
                        <td>
                            @if (rx.HasAlerts)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-exclamation me-1">
                                    </i>
                                    @rx.ValidationAlerts.Count
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check me-1"></i>
                                    Clear
                                </span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-@(
                                  rx.Status == "Active"
                                      ? "success"
                                      : rx.Status == "Dispensed"
                                      ? "info" : "secondary")">
                                @rx.Status
                            </span>
                        </td>
                        <td class="text-muted small">
                            @rx.DateIssued.ToString("dd MMM yyyy")
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Detail"
                                   asp-route-id="@rx.PrescriptionID"
                                   class="btn btn-sm btn-outline-primary"
                                   title="View Detail">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="DownloadPdf"
                                   asp-route-id="@rx.PrescriptionID"
                                   class="btn btn-sm btn-outline-danger"
                                   title="Download PDF">
                                    <i class="bi bi-file-pdf"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable() {
            const search = document.getElementById('searchInput')
                .value.toLowerCase();
            const status = document.getElementById('statusFilter')
                .value;
            const risk   = document.getElementById('riskFilter')
                .value;

            const rows   = document.querySelectorAll(
                '#rxTableBody tr[data-status]');
            let visible  = 0;

            rows.forEach(row => {
                const matchSearch = !search ||
                    row.dataset.search.toLowerCase()
                       .includes(search);
                const matchStatus = !status ||
                    row.dataset.status === status;
                const matchRisk   = !risk   ||
                    row.dataset.risk   === risk;

                const show = matchSearch && matchStatus && matchRisk;
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });

            document.getElementById('rowCount')
                .textContent = visible + ' results';
        }

        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('riskFilter').value   = '';
            filterTable();
        }
    </script>
}