@model SmartMedicalSystem.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-shield-fill-check me-2"></i>
            Admin Dashboard
        </h1>
        <p class="page-subtitle">
            System overview —
            @DateTime.Now.ToString("dddd, MMMM dd yyyy")
        </p>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-xl-2 col-md-4">
        <div class="card stat-card stat-purple">
            <div class="stat-number">@Model.TotalUsers</div>
            <div class="stat-label">Total Users</div>
            <i class="bi bi-people-fill stat-icon"></i>
        </div>
    </div>
    <div class="col-xl-2 col-md-4">
        <div class="card stat-card stat-cyan">
            <div class="stat-number">@Model.TotalDoctors</div>
            <div class="stat-label">Doctors</div>
            <i class="bi bi-person-badge stat-icon"></i>
        </div>
    </div>
    <div class="col-xl-2 col-md-4">
        <div class="card stat-card stat-green">
            <div class="stat-number">@Model.TotalPatients</div>
            <div class="stat-label">Patients</div>
            <i class="bi bi-person-heart stat-icon"></i>
        </div>
    </div>
    <div class="col-xl-2 col-md-4">
        <div class="card stat-card stat-blue">
            <div class="stat-number">
                @Model.TotalPrescriptions
            </div>
            <div class="stat-label">Prescriptions</div>
            <i class="bi bi-journal-medical stat-icon"></i>
        </div>
    </div>
    <div class="col-xl-2 col-md-4">
        <div class="card stat-card stat-amber">
            <div class="stat-number">@Model.TotalAlerts</div>
            <div class="stat-label">Safety Alerts</div>
            <i class="bi bi-exclamation-triangle stat-icon">
            </i>
        </div>
    </div>
    <div class="col-xl-2 col-md-4">
        <div class="card stat-card stat-red">
            <div class="stat-number">
                @Model.HighRiskPatients
            </div>
            <div class="stat-label">High Risk Cases</div>
            <i class="bi bi-heart-pulse stat-icon"></i>
        </div>
    </div>
</div>

<div class="row g-4">

    <!-- Alerts Chart + Table -->
    <div class="col-xl-8">

        <!-- Alert Types Chart -->
        @if (Model.AlertsByType.Any())
        {
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-bar-chart-fill
                               me-2 text-purple"></i>
                    Safety Alerts by Type
                </div>
                <div class="card-body">
                    <canvas id="alertsChart"
                            height="80"></canvas>
                </div>
            </div>
        }

        <!-- Recent Alerts Table -->
        <div class="card">
            <div class="card-header">
                <i class="bi bi-shield-exclamation
                       me-2 text-danger"></i>
                Recent Safety Alerts
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Severity</th>
                            <th>Patient</th>
                            <th>Message</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentAlerts.Any())
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center py-4
                                       text-muted">
                                    No alerts recorded
                                </td>
                            </tr>
                        }
                        @foreach (var alert in Model.RecentAlerts)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-@(
                                          alert.AlertType ==
                                              "DrugInteraction"
                                                  ? "danger"
                                          : alert.AlertType ==
                                              "Allergy"
                                                  ? "warning"
                                          : alert.AlertType ==
                                              "Dosage"
                                                  ? "info"
                                                  : "secondary") text-@(
                                          alert.AlertType == "Allergy"
                                              ? "dark" : "")">
                                        @alert.AlertType
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-@(
                                          alert.Severity == "Critical"
                                              ? "danger"
                                          : alert.Severity == "Warning"
                                              ? "warning"
                                              : "info") text-@(
                                          alert.Severity == "Warning"
                                              ? "dark" : "")">
                                        @alert.Severity
                                    </span>
                                </td>
                                <td class="fw-600 small">
                                    @alert.Prescription?
                                    .Patient?.User?.Name
                                </td>
                                <td class="text-muted small">
                                    @(alert.Message.Length > 60
                                                                    ? alert.Message
                                                                    .Substring(0, 60) + "…"
                                                                    : alert.Message)
                                </td>
                                <td class="text-muted small">
                                    @alert.CreatedAt
                                    .ToString("dd MMM HH:mm")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Right: Quick Links + Stats -->
    <div class="col-xl-4">

        <!-- System Status -->
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-activity me-2 text-green"></i>
                System Status
            </div>
            <div class="card-body">
                @foreach (var item in new[]
                                {
                                ("ML.NET Model",  "Active",  "success"),
                                ("Database",      "Online",  "success"),
                                ("Validation Engine", "Running", "success"),
                                ("Low Stock Items",
                                Model.LowStockMedicines + " medicines",
                                Model.LowStockMedicines > 0
                                ? "warning" : "success"),
                                ("High Risk Cases",
                                Model.HighRiskPatients.ToString(),
                                Model.HighRiskPatients > 0
                                ? "danger" : "success"),
                                })
                {
                    <div class="d-flex justify-content-between
                                align-items-center py-2
                                border-bottom">
                        <span class="small">@item.Item1</span>
                        <span class="badge bg-@item.Item3">
                            @item.Item2
                        </span>
                    </div>
                }
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-lightning me-2"></i>
                Quick Actions
            </div>
            <div class="card-body d-grid gap-2">
                <a asp-action="Users"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-people me-2"></i>
                    Manage Users
                </a>
                <a asp-action="Medicines"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-capsule me-2"></i>
                    Manage Medicines
                </a>
                <a asp-action="DrugInteractions"
                   class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-exclamation-diamond me-2"></i>
                    Drug Interactions
                </a>
                <a asp-action="AuditLog"
                   class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-shield-check me-2"></i>
                    View Audit Log
                </a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        @if (Model.AlertsByType.Any())
        {
                <text>
                const ctx = document.getElementById('alertsChart');
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(
                                                System.Text.Json.JsonSerializer.Serialize(
                                                        Model.AlertsByType.Keys.ToList())),
                datasets: [{
                    data: @Html.Raw(
                                                System.Text.Json.JsonSerializer.Serialize(
                                                        Model.AlertsByType.Values.ToList())),
                    backgroundColor: [
                        '#dc3545','#f59e0b',
                        '#3b82f6','#10b981','#8b5cf6'
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
        </text>
        }
    </script>
}