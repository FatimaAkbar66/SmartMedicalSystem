@model SmartMedicalSystem.Models.Entities.Medicine
@{
    ViewData["Title"] = "Add Medicine";
}

<div class="page-header">
    <h1 class="page-title">
        <i class="bi bi-plus-circle me-2"></i>
        Add New Medicine
    </h1>
</div>

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-capsule me-2 text-purple"></i>
                Medicine Details
            </div>
            <div class="card-body">
                <form asp-action="AddMedicine" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                Generic Name
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="GenericName"
                                   class="form-control"
                                   placeholder="e.g. Amoxicillin"
                                   required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Brand Names
                            </label>
                            <input asp-for="BrandNames"
                                   class="form-control"
                                   placeholder="e.g. Amoxil,Trimox
                            (comma separated)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Active Ingredient
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ActiveIngredient"
                                   class="form-control"
                                   placeholder="e.g. Amoxicillin
                            Trihydrate"
                                   required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Category
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Category"
                                   class="form-control"
                                   placeholder="e.g.
                            Antibiotic/Penicillin"
                                   required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">
                                Min Dosage (mg)
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="MinDosageMg"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">
                                Max Dosage (mg)
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="MaxDosageMg"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">
                                Age Group
                            </label>
                            <select asp-for="AgeGroup"
                                    class="form-select">
                                <option value="All">All Ages</option>
                                <option value="Pediatric">
                                    Pediatric (≤12)
                                </option>
                                <option value="Adult">
                                    Adult (18-64)
                                </option>
                                <option value="Geriatric">
                                    Geriatric (≥65)
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">
                                Stock Quantity
                            </label>
                            <input asp-for="StockQuantity"
                                   class="form-control"
                                   type="number"
                                   value="100" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">
                                Reorder Level
                            </label>
                            <input asp-for="ReorderLevel"
                                   class="form-control"
                                   type="number"
                                   value="10" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">
                                Price (Rs.)
                            </label>
                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   step="0.01" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">
                                Contraindications
                            </label>
                            <input asp-for="Contraindications"
                                   class="form-control"
                                   placeholder="e.g. Penicillin allergy,
                            Liver disease" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">
                                Side Effects
                            </label>
                            <input asp-for="SideEffects"
                                   class="form-control"
                                   placeholder="e.g. Nausea,
                            Diarrhea, Rash" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Expiry Date
                            </label>
                            <input asp-for="ExpiryDate"
                                   class="form-control"
                                   type="date" />
                        </div>
                        <div class="col-md-6 d-flex
                            align-items-end">
                            <div class="form-check mb-2">
                                <input asp-for="RequiresPrescription"
                                       class="form-check-input"
                                       type="checkbox"
                                       checked />
                                <label asp-for="RequiresPrescription"
                                       class="form-check-label fw-600">
                                    Requires Prescription (Rx Only)
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit"
                                class="btn btn-primary flex-fill">
                            <i class="bi bi-save me-2"></i>
                            Save Medicine
                        </button>
                        <a asp-action="Medicines"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>