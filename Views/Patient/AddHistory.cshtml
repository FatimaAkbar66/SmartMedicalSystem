@model SmartMedicalSystem.Models.Entities.MedicalHistory
@{
    ViewData["Title"] = "Add Medical History";
}

<div class="page-header">
    <h1 class="page-title">
        <i class="bi bi-clipboard-plus me-2"></i>
        Add Medical History
    </h1>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-clipboard-pulse
                me-2 text-purple"></i>
                Medical Record Entry
            </div>
            <div class="card-body">
                <form asp-action="AddHistory" method="post">
                    <input type="hidden"
                           name="PatientID"
                           value="@ViewBag.PatientId" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">
                                Diagnosis
                                <span class="text-danger">*</span>
                            </label>
                            <input name="Diagnosis"
                                   class="form-control"
                                   placeholder="e.g. Hypertension Stage 1"
                                   required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Chronic Conditions
                            </label>
                            <input name="ChronicConditions"
                                   class="form-control"
                                   placeholder="e.g. Diabetes,Hypertension" />
                            <small class="text-muted">
                                Separate with commas
                            </small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Surgical History
                            </label>
                            <input name="SurgicalHistory"
                                   class="form-control"
                                   placeholder="e.g. Appendectomy 2010" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Current Medications
                            </label>
                            <input name="CurrentMedications"
                                   class="form-control"
                                   placeholder="e.g. Metformin 500mg" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Family History
                            </label>
                            <input name="FamilyHistory"
                                   class="form-control"
                                   placeholder="e.g. Father - Diabetes" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea name="Notes"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Additional notes...">
                    </textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit"
                                class="btn btn-primary flex-fill">
                            <i class="bi bi-save me-2"></i>
                            Save Medical History
                        </button>
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>